<Window x:Class="DMsound.UI.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DMsound — Soundboard System"
    Height="680" Width="1140"
    MinHeight="560" MinWidth="900"
    Background="{StaticResource BrushBgBase}"
    Foreground="{StaticResource BrushTextSecondary}"
    KeyDown="OnWindowKeyDown"
    AllowDrop="True"
    Drop="OnWindowDrop">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/CyberTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Ligne laser top de la fenêtre -->
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border Background="{StaticResource BrushBgBase}"
                    BorderThickness="0"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ligne laser -->
                    <Rectangle Grid.Row="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent"  Offset="0.0" />
                                <GradientStop Color="#FF00AAFF"    Offset="0.3" />
                                <GradientStop Color="#FF00D4FF"    Offset="0.5" />
                                <GradientStop Color="#FF00AAFF"    Offset="0.7" />
                                <GradientStop Color="Transparent"  Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <AdornerDecorator Grid.Row="1">
                        <ContentPresenter />
                    </AdornerDecorator>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Template>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Grille de sons -->
            <RowDefinition Height="*" />
            <!-- Éditeur audio -->
            <RowDefinition Height="Auto" />
            <!-- Status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             HEADER — Logo + statut
        ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Icône biseautée -->
                <Border Width="36" Height="36"
                        Background="#1A00AAFF"
                        BorderBrush="{StaticResource BrushBorderAccent}"
                        BorderThickness="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               FontSize="16"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DM"
                                   Style="{StaticResource TextTitle}" />
                        <TextBlock Text="sound"
                                   Style="{StaticResource TextTitle}"
                                   Foreground="{StaticResource BrushAccent}" />
                    </StackPanel>
                    <TextBlock Text="SOUNDBOARD SYSTEM V2"
                               Style="{StaticResource TextSub}" />
                </StackPanel>
            </StackPanel>

            <!-- Statut système -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="7" Height="7"
                         Fill="#FF00FF88"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center" />
                <TextBlock Text="SYSTÈME ACTIF"
                           Style="{StaticResource TextLabel}"
                           Foreground="#FF00FF88" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════
             TOOLBAR — Soundboard + Import + Session + Sortie
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelToolbar}"
                BorderThickness="2,1,1,1"
                BorderBrush="{StaticResource BrushBorderAccent}"
                Margin="0,0,0,14">
            <DockPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="IMPORTER"
                            Style="{StaticResource BtnPrimary}"
                            Click="OnImportAudioClicked"
                            Margin="0,0,8,0" />
                    <Button Content="SESSION"
                            Style="{StaticResource BtnSession}"
                            Click="OnOpenSessionClicked" />
                </StackPanel>

                <!-- Séparateur -->
                <Rectangle Width="1" Height="22" Fill="{StaticResource BrushBorderDefault}"
                           Margin="16,0" VerticalAlignment="Center" />

                <!-- Sortie audio -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SORTIE //"
                               Style="{StaticResource TextLabel}"
                               Margin="0,0,12,0" />
                    <ComboBox Style="{StaticResource CyberComboBox}"
                              Width="280"
                              ItemsSource="{Binding AudioOutputDevices}"
                              SelectedItem="{Binding SelectedAudioOutputDevice}"
                              DisplayMemberPath="Name" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════
             GRILLE DE SONS
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelMain}"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Label section -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="SONS DISPONIBLES"
                               Style="{StaticResource TextLabel}"
                               DockPanel.Dock="Left"
                               Margin="0,0,10,0" />
                    <Rectangle Height="1"
                               VerticalAlignment="Center">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF1A3A5A" Offset="0" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </DockPanel>

                <!-- Liste des sons -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource CyberScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Sounds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardSound}"
                                        Width="190"
                                        Margin="0,0,10,10">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding PlayCommand}" />
                                    </Border.InputBindings>
                                    <StackPanel>

                                        <!-- Nom + toggle -->
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding ToggleEnabledCommand}"
                                                    Cursor="Hand"
                                                    Width="36" Height="20"
                                                    Padding="0"
                                                    ToolTip="Activer / Désactiver">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Background" Value="#1A00FF88" />
                                                                <Setter Property="BorderBrush" Value="#FF00FF88" />
                                                                <Setter Property="Foreground" Value="#FF00FF88" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="#FF4A7A9B" />
                                                                <Setter Property="Foreground" Value="#FF4A7A9B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock FontSize="9" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="ON" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Text" Value="OFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextSoundName}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Opacity" Value="0.4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- Badge hotkey -->
                                        <Border Style="{StaticResource BadgeHotkey}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Hotkey, TargetNullValue='—'}"
                                                       Style="{StaticResource TextMono}" />
                                        </Border>

                                        <!-- Actions hotkey -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Style="{StaticResource BadgeHotkey}"
                                                    Margin="0"
                                                    Cursor="Hand"
                                                    ToolTip="Cliquez puis appuyez sur une touche">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding StartCapturingHotkeyCommand}" />
                                                </Border.InputBindings>
                                                <TextBlock Style="{StaticResource TextMono}"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding HotkeyDraft}" />
                                            </Border>
                                            <Button Grid.Column="2"
                                                    Content="ASSIGNER"
                                                    Style="{StaticResource BtnMini}"
                                                    Command="{Binding AssignHotkeyCommand}" />
                                            <Button Grid.Column="4"
                                                    Content="ÉDITER"
                                                    Style="{StaticResource BtnMini}"
                                                    Command="{Binding SelectCommand}"
                                                    Foreground="{StaticResource BrushAccent}" />
                                        </Grid>


                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════
             ÉDITEUR AUDIO
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Style="{StaticResource PanelAccentLeft}"
                Margin="0,0,0,10"
                Visibility="{Binding EditorVisibility}">
            <StackPanel>

                <!-- En-tête éditeur -->
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="// ÉDITEUR AUDIO"
                               Style="{StaticResource TextLabel}"
                               Foreground="{StaticResource BrushAccent}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="✕  FERMER"
                                Style="{StaticResource BtnGhost}"
                                Command="{Binding CloseEditorCommand}"
                                VerticalAlignment="Center" />
                    </StackPanel>

                </DockPanel>

                <!-- Renommer le son en cours d'édition -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="NOM //"
                               Style="{StaticResource TextLabel}"
                               Margin="0,0,12,0" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource CyberTextBox}"
                             Text="{Binding ActiveSoundNameDraft, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" />
                    <Button Grid.Column="3"
                            Content="RENOMMER"
                            Style="{StaticResource BtnPrimary}"
                            Padding="12,5"
                            Click="OnRenameSoundClicked" />
                </Grid>

                <!-- ONDE ORIGINALE -->
                <TextBlock Text="ONDE ORIGINALE"
                           Style="{StaticResource TextLabel}"
                           Margin="0,0,0,6" />

                <Border Style="{StaticResource PanelWave}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Width="{Binding WaveformCanvasWidthPixelsValue}" Height="72" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding OriginalWaveformPeaks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Height="72" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="3" Height="{Binding}"
                                                   Fill="#FF0066AA"
                                                   Margin="1,0"
                                                   VerticalAlignment="Bottom" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle Width="2" Height="72" Fill="#FFEF4444"
                                           Canvas.Left="{Binding OriginalWaveformCursorX}" />
                            </Canvas>
                        </Grid>

                        <DockPanel>
                            <TextBlock Text="MARKER"
                                       Style="{StaticResource TextLabel}"
                                       Margin="0,0,10,0" />
                            <Slider Style="{StaticResource CyberSlider}"
                                    Width="220"
                                    Minimum="0"
                                    Maximum="{Binding OriginalDurationSeconds}"
                                    Value="{Binding OriginalMarkerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OriginalMarkerSeconds, StringFormat={}{0:F2}s}"
                                       Style="{StaticResource TextMono}"
                                       Margin="8,0,16,0"
                                       Foreground="#FFFCA5A5" />
                            <Button Content="▶  LANCER"  Style="{StaticResource BtnPrimary}"  Command="{Binding PlayOriginalCommand}"   Margin="0,0,6,0" Padding="12,5" />
                            <Button Content="■  STOP"    Style="{StaticResource BtnGhost}"    Command="{Binding StopPlaybackCommand}"  Margin="0,0,6,0" Padding="12,5" />
                            <Button Content="↺  RETOUR"  Style="{StaticResource BtnDanger}"   Command="{Binding ResetOriginalMarkerCommand}" Padding="12,5" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ONDE MODIFIÉE -->
                <TextBlock Text="ONDE MODIFIÉE"
                           Style="{StaticResource TextLabel}"
                           Margin="0,0,0,6" />

                <Border Style="{StaticResource PanelWave}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Width="{Binding WaveformCanvasWidthPixelsValue}" Height="72" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding EditableWaveformPeaks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Height="72" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="3" Height="{Binding}"
                                                   Fill="#FF0A4A7A"
                                                   Margin="1,0"
                                                   VerticalAlignment="Bottom" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle Width="2" Height="72" Fill="#FFFFFFFF"
                                           Canvas.Left="{Binding EditableSelectionStartCursorX}" />
                                <Rectangle Width="2" Height="72" Fill="#FFFFFFFF"
                                           Canvas.Left="{Binding EditableSelectionEndCursorX}" />
                                <Rectangle Width="2" Height="72" Fill="#FFEF4444"
                                           Canvas.Left="{Binding EditableWaveformCursorX}" />
                            </Canvas>
                        </Grid>

                        <!-- Marker modifié -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="MARKER"
                                       Style="{StaticResource TextLabel}"
                                       Margin="0,0,10,0" />
                            <Slider Style="{StaticResource CyberSlider}"
                                    Width="180"
                                    Minimum="0"
                                    Maximum="{Binding EditableDurationSeconds}"
                                    Value="{Binding EditableMarkerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EditableMarkerSeconds, StringFormat={}{0:F2}s}"
                                       Style="{StaticResource TextMono}"
                                       Margin="8,0,16,0"
                                       Foreground="#FFFCA5A5" />
                            <Button Content="▶  LANCER"  Style="{StaticResource BtnPrimary}"  Command="{Binding PlayEditedCommand}"        Margin="0,0,6,0" Padding="12,5" />
                            <Button Content="■  STOP"    Style="{StaticResource BtnGhost}"    Command="{Binding StopPlaybackCommand}"      Margin="0,0,6,0" Padding="12,5" />
                            <Button Content="↺  RETOUR"  Style="{StaticResource BtnDanger}"   Command="{Binding ResetEditedMarkerCommand}" Padding="12,5" />
                        </DockPanel>

                        <!-- Sélection début / fin -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="DÉBUT"
                                       Style="{StaticResource TextLabel}"
                                       Margin="0,0,10,0" />
                            <Slider Style="{StaticResource CyberSlider}"
                                    Width="160"
                                    Minimum="0"
                                    Maximum="{Binding EditableDurationSeconds}"
                                    Value="{Binding SelectionStartSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectionStartSeconds, StringFormat={}{0:F2}s}"
                                       Style="{StaticResource TextMono}"
                                       Margin="8,0,20,0" />
                            <TextBlock Text="FIN"
                                       Style="{StaticResource TextLabel}"
                                       Margin="0,0,10,0" />
                            <Slider Style="{StaticResource CyberSlider}"
                                    Width="160"
                                    Minimum="0"
                                    Maximum="{Binding EditableDurationSeconds}"
                                    Value="{Binding SelectionEndSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectionEndSeconds, StringFormat={}{0:F2}s}"
                                       Style="{StaticResource TextMono}"
                                       Margin="8,0,0,0" />
                        </DockPanel>

                        <!-- Actions découpage -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="✂  DÉCOUPER"
                                    Style="{StaticResource BtnTrim}"
                                    Command="{Binding TrimSelectionCommand}"
                                    Padding="14,6"
                                    Margin="0,0,8,0" />
                            <Button Content="↺  RÉINITIALISER"
                                    Style="{StaticResource BtnDanger}"
                                    Command="{Binding ResetEditedSoundCommand}"
                                    Padding="14,6"
                                    Margin="0,0,8,0" />
                            <Button Content="✓  SAUVEGARDER"
                                    Style="{StaticResource BtnSave}"
                                    Command="{Binding SaveTrimmedCommand}"
                                    Padding="14,6" />
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Style="{StaticResource PanelStatusBar}">
            <DockPanel>
                <TextBlock Text="◈"
                           Foreground="{StaticResource BrushAccent}"
                           FontSize="12"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="STATUS"
                           Style="{StaticResource TextLabel}"
                           Margin="0,0,14,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource TextStatus}" />
            </DockPanel>
        </Border>

    </Grid>
</Window>
