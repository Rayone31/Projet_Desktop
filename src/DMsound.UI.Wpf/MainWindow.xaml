<Window x:Class="DMsound.UI.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DMsound.UI.Wpf"
    mc:Ignorable="d"
    Title="DMsound - Soundboard" Height="640" Width="1100"
    Background="#0F172A"
    Foreground="#E2E8F0"
    KeyDown="OnWindowKeyDown"
    AllowDrop="True"
    Drop="OnWindowDrop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="DMsound" FontSize="34" FontWeight="Bold" />
            <TextBlock Text="Selectionne une soundboard puis declenche un son." FontSize="15" Opacity="0.8" />
        </StackPanel>

        <Border Grid.Row="1" Background="#111827" CornerRadius="14" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Soundboard active" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                    <ComboBox Width="260"
                              ItemsSource="{Binding Soundboards}"
                              SelectedItem="{Binding SelectedSoundboard}"
                              DisplayMemberPath="Name"
                              Background="#1F2937"
                              Foreground="#E2E8F0"
                              BorderBrush="#374151" />
                    <Button Content="Importer"
                        Click="OnImportAudioClicked"
                        Margin="12,0,0,0"
                        Padding="14,6"
                        Background="#0EA5E9"
                        Foreground="#0F172A"
                        BorderBrush="#0284C7"
                        VerticalAlignment="Center" />
                    <Button Content="Session"
                        Click="OnOpenSessionClicked"
                        Margin="12,0,0,0"
                        Padding="14,6"
                        Background="#22C55E"
                        Foreground="#0F172A"
                        BorderBrush="#15803D"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sortie audio" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                    <ComboBox Width="320"
                              ItemsSource="{Binding AudioOutputDevices}"
                              SelectedItem="{Binding SelectedAudioOutputDevice}"
                              DisplayMemberPath="Name"
                              Background="#1F2937"
                              Foreground="#E2E8F0"
                              BorderBrush="#374151" />
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.85" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#111827" CornerRadius="18" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sounds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding PlayCommand}"
                                    Margin="0,0,14,14"
                                    Padding="18"
                                    Background="#1E293B"
                                    BorderBrush="#334155"
                                    Foreground="#F8FAFC"
                                    MinWidth="180"
                                    MinHeight="92">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Hotkey, StringFormat=Touche : {0}}"
                                               Margin="0,8,0,0"
                                               Opacity="0.78" />
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox Width="70"
                                                 Text="{Binding HotkeyDraft, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#334155"
                                                 Foreground="#F8FAFC"
                                                 BorderBrush="#475569"
                                                 MaxLength="3" />
                                        <Button Content="Assigner"
                                                Command="{Binding AssignHotkeyCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                Background="#0EA5E9"
                                                Foreground="#0F172A"
                                                BorderBrush="#0284C7" />
                                        <Button Content="Editer"
                                                Command="{Binding SelectCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                Background="#14B8A6"
                                                Foreground="#0F172A"
                                                BorderBrush="#0F766E" />
                                    </DockPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3"
                Background="#111827"
                CornerRadius="18"
                Padding="20"
                Margin="0,16,0,0"
                Visibility="{Binding EditorVisibility}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Editeur audio" FontSize="20" FontWeight="SemiBold" />
                    <Button Content="Fermer"
                            Command="{Binding CloseEditorCommand}"
                            DockPanel.Dock="Right"
                            Padding="10,4"
                            Background="#475569"
                            Foreground="#F8FAFC"
                            BorderBrush="#334155" />
                </DockPanel>

                <TextBlock Text="{Binding SelectedSoundEditor.Name}" Margin="0,6,0,0" Opacity="0.8" />
                <TextBlock Text="{Binding SelectedSoundEditor.FilePath}" Margin="0,2,0,2" Opacity="0.6" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Version modifiee: " Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding EditableFilePath}" Opacity="0.6" FontSize="12" />
                </StackPanel>

                <Border Background="#0B1220" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Onde originale" FontWeight="SemiBold" />

                        <Grid Width="{Binding WaveformCanvasWidthPixelsValue}" Height="90" Margin="0,8,0,8">
                            <ItemsControl ItemsSource="{Binding OriginalWaveformPeaks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Height="90" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="4"
                                                   Height="{Binding}"
                                                   Fill="#38BDF8"
                                                   Margin="1,0"
                                                   VerticalAlignment="Bottom" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Canvas IsHitTestVisible="False">
                                <Rectangle Width="2"
                                           Height="90"
                                           Fill="#EF4444"
                                           Canvas.Left="{Binding OriginalWaveformCursorX}" />
                            </Canvas>
                        </Grid>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Marker rouge" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Width="260"
                                    Minimum="0"
                                    Maximum="{Binding OriginalDurationSeconds}"
                                    Value="{Binding OriginalMarkerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    Foreground="#EF4444"
                                    Background="#1F2937" />
                            <TextBlock Text="{Binding OriginalMarkerSeconds, StringFormat={}{0:F2}s}" Margin="8,0,0,0" Foreground="#FCA5A5" VerticalAlignment="Center" />
                            <Button Content="Lancer" Command="{Binding PlayOriginalCommand}" Margin="12,0,0,0" Padding="10,4" Background="#0EA5E9" Foreground="#0F172A" BorderBrush="#0284C7" />
                            <Button Content="Stop" Command="{Binding StopPlaybackCommand}" Margin="8,0,0,0" Padding="10,4" Background="#334155" Foreground="#F8FAFC" BorderBrush="#1E293B" />
                            <Button Content="Retour" Command="{Binding ResetOriginalMarkerCommand}" Margin="8,0,0,0" Padding="10,4" Background="#991B1B" Foreground="#FEE2E2" BorderBrush="#7F1D1D" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#0B1220" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Onde modifiee" FontWeight="SemiBold" />

                        <Grid Width="{Binding WaveformCanvasWidthPixelsValue}" Height="90" Margin="0,8,0,8">
                            <ItemsControl ItemsSource="{Binding EditableWaveformPeaks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Height="90" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="4"
                                                   Height="{Binding}"
                                                   Fill="#22D3EE"
                                                   Margin="1,0"
                                                   VerticalAlignment="Bottom" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Canvas IsHitTestVisible="False">
                                <Rectangle Width="2"
                                           Height="90"
                                           Fill="#FFFFFF"
                                           Canvas.Left="{Binding EditableSelectionStartCursorX}" />
                                <Rectangle Width="2"
                                           Height="90"
                                           Fill="#FFFFFF"
                                           Canvas.Left="{Binding EditableSelectionEndCursorX}" />
                                <Rectangle Width="2"
                                           Height="90"
                                           Fill="#EF4444"
                                           Canvas.Left="{Binding EditableWaveformCursorX}" />
                            </Canvas>
                        </Grid>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Marker rouge" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Width="220"
                                    Minimum="0"
                                    Maximum="{Binding EditableDurationSeconds}"
                                    Value="{Binding EditableMarkerSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    Foreground="#EF4444"
                                    Background="#1F2937" />
                            <TextBlock Text="{Binding EditableMarkerSeconds, StringFormat={}{0:F2}s}" Margin="8,0,0,0" Foreground="#FCA5A5" VerticalAlignment="Center" />
                            <Button Content="Lancer" Command="{Binding PlayEditedCommand}" Margin="12,0,0,0" Padding="10,4" Background="#14B8A6" Foreground="#0F172A" BorderBrush="#0F766E" />
                            <Button Content="Stop" Command="{Binding StopPlaybackCommand}" Margin="8,0,0,0" Padding="10,4" Background="#334155" Foreground="#F8FAFC" BorderBrush="#1E293B" />
                            <Button Content="Retour" Command="{Binding ResetEditedMarkerCommand}" Margin="8,0,0,0" Padding="10,4" Background="#991B1B" Foreground="#FEE2E2" BorderBrush="#7F1D1D" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Barre debut" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Width="200"
                                    Minimum="0"
                                    Maximum="{Binding EditableDurationSeconds}"
                                    Value="{Binding SelectionStartSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    Foreground="#F59E0B"
                                    Background="#1F2937" />
                            <TextBlock Text="{Binding SelectionStartSeconds, StringFormat={}{0:F2}s}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="Barre fin" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <Slider Width="200"
                                    Minimum="0"
                                    Maximum="{Binding EditableDurationSeconds}"
                                    Value="{Binding SelectionEndSeconds, UpdateSourceTrigger=PropertyChanged}"
                                    Foreground="#A78BFA"
                                    Background="#1F2937" />
                            <TextBlock Text="{Binding SelectionEndSeconds, StringFormat={}{0:F2}s}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Decouper"
                                    Command="{Binding TrimSelectionCommand}"
                                    Padding="12,5"
                                    Background="#F59E0B"
                                    Foreground="#0F172A"
                                    BorderBrush="#B45309" />
                            <Button Content="Reinitialiser"
                                Command="{Binding ResetEditedSoundCommand}"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                Background="#F97316"
                                Foreground="#0F172A"
                                BorderBrush="#C2410C" />
                            <Button Content="Sauvegarder"
                                    Command="{Binding SaveTrimmedCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,5"
                                    Background="#22C55E"
                                    Foreground="#052E16"
                                    BorderBrush="#15803D" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,16,0,0"
                   Text="Feature 3: waveform, pre-ecoute et decoupage audio"
                   Opacity="0.55"
                   HorizontalAlignment="Right" />
    </Grid>
</Window>
