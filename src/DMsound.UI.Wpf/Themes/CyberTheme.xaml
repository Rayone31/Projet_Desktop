<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         COULEURS
    ═══════════════════════════════════════════════════ -->

    <!-- Fonds -->
    <Color x:Key="ColorBgDeep">#FF060C18</Color>
    <Color x:Key="ColorBgBase">#FF0A0E1A</Color>
    <Color x:Key="ColorBgPanel">#FF0D1525</Color>
    <Color x:Key="ColorBgCard">#FF0D1525</Color>
    <Color x:Key="ColorBgCardHover">#FF101D30</Color>
    <Color x:Key="ColorBgInput">#FF0A1628</Color>
    <Color x:Key="ColorBgEditor">#FF0A0F1E</Color>
    <Color x:Key="ColorBgWave">#FF060C18</Color>

    <!-- Bordures -->
    <Color x:Key="ColorBorderDefault">#FF1A2A3E</Color>
    <Color x:Key="ColorBorderSubtle">#FF0E1E30</Color>
    <Color x:Key="ColorBorderAccent">#FF00AAFF</Color>
    <Color x:Key="ColorBorderInput">#FF1E3A5A</Color>

    <!-- Accent bleu laser -->
    <Color x:Key="ColorAccent">#FF00AAFF</Color>
    <Color x:Key="ColorAccentBright">#FF00D4FF</Color>
    <Color x:Key="ColorAccentDim">#4400AAFF</Color>

    <!-- Accent vert session -->
    <Color x:Key="ColorGreen">#FF00FF88</Color>

    <!-- Textes -->
    <Color x:Key="ColorTextPrimary">#FFE0EEFF</Color>
    <Color x:Key="ColorTextSecondary">#FFC8D8F0</Color>
    <Color x:Key="ColorTextMuted">#FF4A7A9B</Color>
    <Color x:Key="ColorTextDim">#FF2A5A7A</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BrushBgDeep"         Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="BrushBgBase"          Color="{StaticResource ColorBgBase}" />
    <SolidColorBrush x:Key="BrushBgPanel"         Color="{StaticResource ColorBgPanel}" />
    <SolidColorBrush x:Key="BrushBgCard"          Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover"     Color="{StaticResource ColorBgCardHover}" />
    <SolidColorBrush x:Key="BrushBgInput"         Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBgEditor"        Color="{StaticResource ColorBgEditor}" />
    <SolidColorBrush x:Key="BrushBgWave"          Color="{StaticResource ColorBgWave}" />
    <SolidColorBrush x:Key="BrushBorderDefault"   Color="{StaticResource ColorBorderDefault}" />
    <SolidColorBrush x:Key="BrushBorderSubtle"    Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderAccent"    Color="{StaticResource ColorBorderAccent}" />
    <SolidColorBrush x:Key="BrushBorderInput"     Color="{StaticResource ColorBorderInput}" />
    <SolidColorBrush x:Key="BrushAccent"          Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentBright"    Color="{StaticResource ColorAccentBright}" />
    <SolidColorBrush x:Key="BrushGreen"           Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="BrushTextPrimary"     Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary"   Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted"       Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextDim"         Color="{StaticResource ColorTextDim}" />
    <SolidColorBrush x:Key="BrushTransparent"     Color="Transparent" />

    <!-- ═══════════════════════════════════════════════════
         TYPOGRAPHIE
    ═══════════════════════════════════════════════════ -->

    <FontFamily x:Key="FontMain">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}" />
        <Setter Property="FontSize"     Value="13" />
        <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"     Value="26" />
        <Setter Property="FontWeight"   Value="Bold" />
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}" />

    </Style>

    <Style x:Key="TextSub" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"     Value="11" />
        <Setter Property="FontFamily"   Value="{StaticResource FontMono}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushTextMuted}" />

    </Style>

    <Style x:Key="TextLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"     Value="11" />
        <Setter Property="FontFamily"   Value="{StaticResource FontMono}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushTextMuted}" />

    </Style>

    <Style x:Key="TextAccent" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"     Value="13" />
        <Setter Property="FontFamily"   Value="{StaticResource FontMono}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushAccent}" />
    </Style>

    <Style x:Key="TextSoundName" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"     Value="14" />
        <Setter Property="FontWeight"   Value="SemiBold" />
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}" />

    </Style>

    <Style x:Key="TextMono" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontFamily"   Value="{StaticResource FontMono}" />
        <Setter Property="FontSize"     Value="11" />
        <Setter Property="Foreground"   Value="{StaticResource BrushAccent}" />
    </Style>

    <Style x:Key="TextStatus" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize"     Value="12" />
        <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}" />

    </Style>

    <!-- ═══════════════════════════════════════════════════
         BOUTONS
    ═══════════════════════════════════════════════════ -->

    <!-- Bouton primaire (bleu laser) -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground">
            <Setter.Value><SolidColorBrush Color="#FF050D1A" /></Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"      Value="16,7" />
        <Setter Property="FontFamily"   Value="{StaticResource FontMain}" />
        <Setter Property="FontSize"     Value="12" />
        <Setter Property="FontWeight"   Value="SemiBold" />

        <Setter Property="Cursor"       Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushAccentBright}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton session (vert) -->
    <Style x:Key="BtnSession" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Background" Value="{StaticResource BrushGreen}" />
        <Setter Property="Foreground">
            <Setter.Value><SolidColorBrush Color="#FF020F0A" /></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton ghost (transparent, bordure accent) -->
    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Padding"          Value="12,5" />
        <Setter Property="FontFamily"       Value="{StaticResource FontMain}" />
        <Setter Property="FontSize"         Value="11" />
        <Setter Property="FontWeight"       Value="SemiBold" />

        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background">
                                <Setter.Value><SolidColorBrush Color="#1100AAFF" /></Setter.Value>
                            </Setter>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mini bouton dans les cards de son -->
    <Style x:Key="BtnMini" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Padding"          Value="0,4" />
        <Setter Property="FontSize"         Value="10" />

        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="Foreground"       Value="{StaticResource BrushTextMuted}" />
    </Style>

    <!-- Bouton action éditeur (orange/amber) -->
    <Style x:Key="BtnTrim" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Foreground">
            <Setter.Value><SolidColorBrush Color="#FFEFAB27" /></Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value><SolidColorBrush Color="#44EF9F27" /></Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton sauvegarder (vert) -->
    <Style x:Key="BtnSave" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Background" Value="{StaticResource BrushGreen}" />
        <Setter Property="Foreground">
            <Setter.Value><SolidColorBrush Color="#FF020F0A" /></Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton danger (rouge) -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Foreground">
            <Setter.Value><SolidColorBrush Color="#FFEF4444" /></Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value><SolidColorBrush Color="#44EF4444" /></Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════
         COMBOBOX
    ═══════════════════════════════════════════════════ -->

    <Style x:Key="CyberComboBox" TargetType="ComboBox">
        <Setter Property="Background"           Value="{StaticResource BrushBgInput}" />
        <Setter Property="Foreground"           Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush"          Value="{StaticResource BrushBorderInput}" />
        <Setter Property="BorderThickness"      Value="1" />
        <Setter Property="Padding"              Value="10,6" />
        <Setter Property="FontFamily"           Value="{StaticResource FontMain}" />
        <Setter Property="FontSize"             Value="13" />
        <Setter Property="Height"               Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1"
                                                       Text="▾"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <TextBlock x:Name="ContentSite"
                                   Margin="10,0,28,0"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedItem.Name}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontFamily="{StaticResource FontMain}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               StaysOpen="False"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{StaticResource BrushBgPanel}"
                                    BorderBrush="{StaticResource BrushBorderAccent}"
                                    BorderThickness="1"
                                    MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}"
                                    MaxHeight="200"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"   Value="Transparent" />
                    <Setter Property="Foreground"   Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="Padding"      Value="10,7" />
                    <Setter Property="FontFamily"   Value="{StaticResource FontMain}" />
                    <Setter Property="FontSize"     Value="13" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value><SolidColorBrush Color="#1A00AAFF" /></Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════
         TEXTBOX
    ═══════════════════════════════════════════════════ -->

    <Style x:Key="CyberTextBox" TargetType="TextBox">
        <Setter Property="Background"           Value="{StaticResource BrushBgInput}" />
        <Setter Property="Foreground"           Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush"          Value="{StaticResource BrushBorderInput}" />
        <Setter Property="BorderThickness"      Value="1" />
        <Setter Property="Padding"              Value="8,5" />
        <Setter Property="FontFamily"           Value="{StaticResource FontMain}" />
        <Setter Property="FontSize"             Value="13" />
        <Setter Property="Height"               Value="30" />
        <Setter Property="CaretBrush"           Value="{StaticResource BrushAccent}" />
        <Setter Property="SelectionBrush"       Value="{StaticResource BrushAccent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox mono (hotkey) -->
    <Style x:Key="CyberTextBoxMono" TargetType="TextBox" BasedOn="{StaticResource CyberTextBox}">
        <Setter Property="FontFamily"   Value="{StaticResource FontMono}" />
        <Setter Property="FontSize"     Value="12" />
        <Setter Property="Foreground"   Value="{StaticResource BrushAccent}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════
         SLIDER
    ═══════════════════════════════════════════════════ -->

    <Style x:Key="CyberSlider" TargetType="Slider">
        <Setter Property="Foreground"   Value="{StaticResource BrushAccent}" />
        <Setter Property="Background"   Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="Height"       Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Track x:Name="PART_Track" Grid.Row="0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="2" Background="{StaticResource BrushAccent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Width="10" Height="10"
                                                       Fill="{StaticResource BrushAccent}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform Angle="45" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="2" Background="{StaticResource BrushBorderDefault}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════
         SCROLLBAR
    ═══════════════════════════════════════════════════ -->

    <Style x:Key="CyberScrollBar" TargetType="ScrollBar">
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="Width"        Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BrushBorderAccent}"
                                                    CornerRadius="3"
                                                    Opacity="0.5" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CyberScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Style="{StaticResource CyberScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════
         PANELS / BORDURES
    ═══════════════════════════════════════════════════ -->

    <!-- Panel toolbar : fond + bordure gauche accent -->
    <Style x:Key="PanelToolbar" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness"  Value="0,1,1,1" />
        <Setter Property="Padding"          Value="16,10" />
    </Style>

    <!-- Panel principal (grille de sons, éditeur) -->
    <Style x:Key="PanelMain" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Padding"          Value="16" />
    </Style>

    <!-- Panel avec accent gauche bleu -->
    <Style x:Key="PanelAccentLeft" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgEditor}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderAccent}" />
        <Setter Property="BorderThickness"  Value="2,1,1,1" />
        <Setter Property="Padding"          Value="16" />
    </Style>

    <!-- Panel waveform interne -->
    <Style x:Key="PanelWave" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgWave}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Padding"          Value="12" />
    </Style>

    <!-- Card de son -->
    <Style x:Key="CardSound" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgCard}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Padding"          Value="12,10" />
        <Setter Property="Cursor"           Value="Hand" />
    </Style>

    <!-- Badge hotkey -->
    <Style x:Key="BadgeHotkey" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgInput}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderInput}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Padding"          Value="6,1" />
        <Setter Property="Margin"           Value="0,4,0,8" />
    </Style>

    <!-- Panel status bar bas -->
    <Style x:Key="PanelStatusBar" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource BrushBgPanel}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBorderDefault}" />
        <Setter Property="BorderThickness"  Value="0,1,2,0" />
        <Setter Property="Padding"          Value="14,8" />
    </Style>

</ResourceDictionary>
