<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\DemoMp3\**\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DMsound.Application\DMsound.Application.csproj" />
    <ProjectReference Include="..\DMsound.Infrastructure.Audio\DMsound.Infrastructure.Audio.csproj" />
    <ProjectReference Include="..\DMsound.Infrastructure.Persistence\DMsound.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\DMsound.Session.LanTester\DMsound.Session.LanTester.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
